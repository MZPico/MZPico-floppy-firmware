; MZ-800 expansion-bus servicing for the MZPico-800-Floppy-Board.
;
; Gate ownership: the PIO side-set drives ALL THREE gate lines (3 bits, base
; GPIO26):
;   bit0 = ~EN0 (GPIO26) address buffer U1 /OE, active low
;   bit1 = ~EN1 (GPIO27) data buffer U2 /OE, active low
;   bit2 = ~RD1 (GPIO28) U2 direction: 1 = bus D -> Pico C, 0 = Pico C -> bus D
; core1 owns only C0..C7 (GPIO0-7), which it drives during the read-data phase.
;
; The rule "never drive the MZ-800 data bus for a port we don't own" holds by
; construction, without core1 ever touching a gate:
;   READ:  every gate stays OFF after the address capture until core1 queues
;          its verdict word in this SM's TX FIFO: 1 (ours, byte already on
;          C0..C7) turns U2 toward the bus, 0 (not ours / too late) leaves it
;          off. Driving a stale byte for unserved reads is what made the
;          reference Deluxe board show a phantom SRAM card and overdrive a
;          second card on the same bus.
;   WRITE: U2 turns toward the Pico (input direction, loads the bus with one
;          LVC input, never drives it) and the PIO captures the data byte as a
;          second FIFO word ~80 ns into the cycle. The Z80 drives write data
;          before /WR falls and holds it for the whole cycle, so the sample is
;          timing-safe and core1 no longer races the end of the cycle to read
;          C0..C7 (the "late at sample" failure mode is gone).
;
; Never assert ~EN0 and ~EN1 together: every switch passes through BLOCK
; (break-before-make), one PIO cycle apart.
;
; A side-set must never sit inside an SM's wait_iorq_low loop: each SM spins in
; that loop for the whole of the OTHER kind of cycle and would re-assert its
; idle gates every two cycles over the capturing SM's sequence.
;
; GUARD DELAY (~24 cycles = ~133 ns @180 MHz, a counted loop: the 3-bit side-set leaves one delay bit) between "IORQ released" and
; re-enabling the address buffer: core1 is still driving C0..C7 for a few tens
; of ns after a read cycle, and U1's 24 mA drivers must not meet the Pico pads.
; Cheap: the Z80 cannot start another I/O cycle for >= 3 us.

.define GATES_ADDR     0b110   ; U1 on (addr -> C), U2 off, dir = read
.define GATES_BLOCK    0b111   ; all off
.define GATES_DATA_IN  0b101   ; U2 on, bus D -> Pico C (write capture)
.define GATES_DATA_OUT 0b001   ; U2 on, Pico C -> bus D (read drive)

; MZ I/O READ cycle. One RX word (port address); core1 answers with exactly
; ONE verdict word in the TX FIFO: 1 = ours, the byte is already driven on
; C0..C7 (sent right before EXWAIT is released), 0 = not ours or too late.
; The SM waits for that word and nothing else: no bus input is sampled
; mid-cycle. On the reference Deluxe board (v0.3.1 -> v0.3.2, bisected on two
; layouts) both alternatives failed: turning U2 before core1 drove the pins
; put a floating byte on the bus (~1 in 10^4 reads corrupt), and watching
; /RD to detect "the Z80 gave up" let a coupled glitch abandon reads core1
; was serving (BASIC froze after loading ~30% of the time). EXWAIT holds the
; Z80 for served ports, and the not-ours answer comes within ~150 ns, so the
; pull never outlives a cycle by more than that; one word per read keeps the
; FIFO balanced (restart_bus_sms clears it). jmp_pin = RD.
.program bus_read
.side_set 3 opt
.wrap_target
    nop                 side GATES_ADDR   ; idle gates set ONCE, outside the loop
wait_iorq_low:
    wait 0 gpio 8
    jmp pin, wait_iorq_low            ; loop while RD high (not a read)
    in pins, 8          side GATES_BLOCK   ; port address pushed; all gates off
    pull block                        ; core1's verdict
    out x, 32
    jmp !x, cycle_end                 ; 0: nothing driven
    nop                 side GATES_DATA_OUT ; 1: U2 drives the bus with C0..C7
cycle_end:
    ; IORQ spike filter (cf. the reference Deluxe read program): the U2 turn-on
    ; edge can couple a few-ns spike into the IORQ input; the 2-cycle input
    ; synchroniser can latch it and satisfy a single wait. Outlast it (~90 ns)
    ; and re-verify before dropping the drive - a real cycle end is hundreds
    ; of ns high and passes straight through.
    wait 1 gpio 8
    set x, 15
spike_r:
    jmp x-- spike_r
    wait 1 gpio 8
    nop                 side GATES_BLOCK ; drop the drive first...
    set y, 22                            ; ...then the guard before U1 returns:
guard_r:                                 ; 1 set + 23 loop cycles (~133 ns).
    jmp y-- guard_r                      ; (.side_set 3 opt leaves 1 delay bit)
.wrap

; MZ I/O WRITE cycle. Two FIFO words: port address, then the PIO-captured data
; byte. jmp_pin = WR.
.program bus_write
.side_set 3 opt
.wrap_target
    nop                 side GATES_ADDR   ; idle gates set ONCE, outside the loop
wait_iorq_low:
    wait 0 gpio 8
    jmp pin, wait_iorq_low            ; loop while WR high (not a write)
    in pins, 8          side GATES_BLOCK   ; port address pushed; U1 off
    nop                 side GATES_DATA_IN ; break-before-make: U2 on, bus -> Pico
    ; Settle: U2 enable (~5 ns) plus the 2-cycle input synchroniser; a couple
    ; of nops is NOT enough, and .side_set 3 opt leaves 1 delay bit. 1 set + 8.
    set x, 7
settle_w:
    jmp x-- settle_w
    in pins, 8          side GATES_BLOCK   ; data byte pushed; all gates off
    wait 1 gpio 8                     ; cycle over; guard before U1 returns
    set y, 22
guard_w:
    jmp y-- guard_w
.wrap

% c-sdk {
#include "hardware/pio.h"

static inline void bus_read_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = bus_read_program_get_default_config(offset);
    sm_config_set_in_pins(&c, 0);          // C0..C7 = GPIO0-7
    sm_config_set_jmp_pin(&c, 9);          // RD
    sm_config_set_in_shift(&c, true, true, 8);
    sm_config_set_sideset_pins(&c, 26);    // EN0, EN1, RD1
    sm_config_set_clkdiv(&c, 1.0f);
    // TX FIFO carries core1's verdict word, so it cannot be joined into RX: RX
    // keeps its native 4 words.
    pio_sm_set_consecutive_pindirs(pio, sm, 26, 3, true);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void bus_write_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = bus_write_program_get_default_config(offset);
    sm_config_set_in_pins(&c, 0);
    sm_config_set_jmp_pin(&c, 10);         // WR
    sm_config_set_in_shift(&c, true, true, 8);
    sm_config_set_sideset_pins(&c, 26);
    sm_config_set_clkdiv(&c, 1.0f);
    // Two words per write; TX is unused, join it into RX for 8 words (4 writes)
    // of backlog headroom under a tight OUT loop.
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    pio_sm_set_consecutive_pindirs(pio, sm, 26, 3, true);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
