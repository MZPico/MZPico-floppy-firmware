# Toolchains the builds are checked with, in one place (CI reads this; use the same locally).
# z88dk (the MZ-800 test programs in mzf/): the same pinned Docker image as
# MZPico's other MZ-800 projects -- z88dk's snap channel is nightly, so pin it.
Z88DK_IMAGE=z88dk/z88dk:sha-94be67e
# arm-none-eabi-gcc for the firmware: Ubuntu 24.04's gcc-arm-none-eabi (13.2),
# the version the firmware was brought up with. The pico-sdk is the submodule.
